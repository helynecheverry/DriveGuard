# ============================================================
# DriveGuard Lab - copie este archivo como .env y complételo
# ============================================================

# --- MongoDB (local o Atlas) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=driveguard_lab

# --- API FastAPI ---
API_URL=http://127.0.0.1:8000

# --- Modelos ---
# LANDMARKER_PATH=models/face_landmarker.task
FACE_MODEL_ID=trpakov/vit-face-expression
FACE_DEVICE=cpu
# Expresiones faciales (ViT). En CPU es lento: suba el intervalo si va lento.
EXPRESIONES_ACTIVAS=true
EXPRESION_INTERVALO_S=2.0
# Método para decidir ojo cerrado: ear (por defecto) o cnn (requiere notebook 04)
OJOS_METODO=ear

# --- Alarma local: auto | pygame | winsound | ninguno ---
ALARMA_BACKEND=auto

# --- Notificaciones ---
# true = no envía mensajes reales (para practicar sin credenciales)
NOTIFICACIONES_SIMULADAS=false
# Segundos mínimos entre dos alertas de la misma sesión
ALERTA_COOLDOWN_S=120

# Correo (Gmail: use una "contraseña de aplicación", no su contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram (cree el bot con @BotFather)
TELEGRAM_BOT_TOKEN=

# SMS con Twilio (opcional; la cuenta de prueba solo envía a números verificados)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
